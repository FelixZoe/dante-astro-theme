---
import { getCollection } from 'astro:content';
import ArrowRight from '../../assets/icons/arrow-right.svg';
import Subscribe from '../../components/Subscribe.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, sortItemsByDateDesc } from '../../utils/data-utils';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const tags = getAllTags(posts).sort((tagA, tagB) => {
    const postCountTagA = getPostsByTag(posts, tagA.id).length;
    const postCountTagB = getPostsByTag(posts, tagB.id).length;
    return postCountTagB - postCountTagA;
});
---

<BaseLayout
    title="标签"
    description="按标签浏览 Felix 的技术文章、项目记录与学习内容。"
    showHeader={false}
>
    <header class="page-intro mb-8 sm:mb-10">
        <p class="eyebrow mb-3">分类</p>
        <h1 class="font-serif text-4xl leading-tight font-medium tracking-[-0.03em] sm:text-5xl">全部标签</h1>
        <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-relaxed sm:text-base">
            按主题快速浏览文章，找到感兴趣的技术方向与实践记录。
        </p>
    </header>
    {
        tags.length > 0 ? (
            <div class="grid gap-4 sm:grid-cols-2 sm:gap-5">
                {tags.map((tag) => {
                    const postCount = getPostsByTag(posts, tag.id).length;
                    return (
                        <a
                            class="preview-card group flex items-center justify-between gap-5 rounded-2xl p-5 sm:p-6"
                            href={`/tags/${tag.id}`}
                        >
                            <div class="min-w-0 grow">
                                <h2 class="font-serif text-xl leading-tight font-medium transition-colors group-hover:text-accent sm:text-2xl">
                                    {tag.name}
                                </h2>
                                <div class="text-muted-foreground mt-2 text-sm leading-normal">{postCount} 篇文章</div>
                            </div>
                            <span class="icon-chip inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full" aria-hidden="true">
                                <ArrowRight class="h-4 w-4 fill-current" />
                            </span>
                        </a>
                    );
                })}
            </div>
        ) : (
            <div class="preview-card rounded-2xl px-6 py-12 text-center sm:px-10 sm:py-16">
                <p class="eyebrow mb-3">等待内容</p>
                <h2 class="font-serif text-2xl font-medium sm:text-3xl">标签将在发布文章后出现</h2>
                <p class="text-muted-foreground mx-auto mt-3 max-w-xl text-sm leading-relaxed sm:text-base">
                    为文章添加标签后，这里会自动生成对应的分类入口。
                </p>
            </div>
        )
    }
    <Subscribe class="my-16 sm:my-24" />
</BaseLayout>
