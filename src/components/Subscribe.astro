---
import siteConfig from '../data/site-config';
import Button from './Button.astro';

type Props = { class?: string };

const { class: className } = Astro.props;
const subscribe = siteConfig.subscribe;
if (!subscribe?.enabled || !subscribe?.form?.action) {
    return;
}
---

<section class:list={['bg-accent-soft flex flex-col items-center gap-3 rounded-[2rem] px-6 py-12 text-center sm:px-12 sm:py-16', className]}>
    <p class="eyebrow">订阅更新</p>
    {subscribe.title && <h2 class="w-full max-w-2xl font-serif text-3xl leading-tight font-medium tracking-[-0.025em] sm:text-4xl">{subscribe.title}</h2>}
    {subscribe.text && <p class="text-muted-foreground w-full max-w-xl text-sm leading-relaxed sm:text-base">{subscribe.text}</p>}
    <form
        action={subscribe.form.action}
        method="post"
        id="subscribe-form"
        name="subscribe-form"
        class:list={['flex w-full max-w-xl flex-col gap-3 sm:flex-row', { 'mt-5': subscribe.title || subscribe.text }]}
        target="_blank"
    >
        <input
            type="email"
            name={subscribe.form.emailFieldName || 'email'}
            required
            autocomplete="email"
            placeholder="请输入邮箱地址"
            class="bg-surface text-main placeholder:text-muted-foreground h-11 w-full rounded-full px-5 py-2 text-sm shadow-[0_8px_24px_-20px_var(--shadow-color)] transition focus:outline-none focus:ring-2 focus:ring-accent"
            aria-label="邮箱地址"
        />
        {subscribe.form.hiddenFields?.map((field) => <input type="hidden" name={field.name} value={field.value} />)}
        {
            subscribe.form.honeypotFieldName && (
                <div style="position: absolute; left: -5000px;" aria-hidden="true">
                    <input type="text" name={subscribe.form.honeypotFieldName} tabindex="-1" autocomplete="off" />
                </div>
            )
        }
        <Button type="submit" class="h-11 w-full whitespace-nowrap sm:w-auto">立即订阅</Button>
    </form>
</section>
