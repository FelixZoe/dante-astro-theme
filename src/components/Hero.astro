---
import { marked } from 'marked';
import type { Hero as HeroProps } from '../types';
import Button from './Button.astro';
import CustomImage from './CustomImage.astro';

type Props = HeroProps;

const { title, image, text, actions } = Astro.props;
---

{
    (title || image?.src || text || (actions && actions.length > 0)) && (
        <section class="border-main bg-muted relative left-1/2 mb-20 w-[min(1120px,calc(100vw-2rem))] -translate-x-1/2 overflow-hidden border-y border-dashed px-6 py-10 sm:mb-28 sm:px-10 sm:py-14 lg:grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-14 lg:px-14">
            <div class="flex flex-col gap-6 lg:py-4">
                {title && (
                    <h1 class="font-serif text-4xl leading-[1.08] font-medium sm:text-5xl lg:text-6xl">
                        {title}
                    </h1>
                )}
                {text && <div class="prose sm:prose-lg max-w-2xl" set:html={marked.parse(text)} />}
                {actions && actions.length > 0 && (
                    <div class="flex flex-wrap gap-4 pt-1">
                        {actions.map((action) => (
                            <Button href={action.href}>{action.text}</Button>
                        ))}
                    </div>
                )}
            </div>

            {image?.src && (
                <figure class="mt-10 lg:mt-0">
                    <CustomImage
                        class="aspect-[4/3] w-full object-cover"
                        {...image}
                        widths={[480, 640, 768, 1024, 1536]}
                        sizes="(min-width: 1024px) 560px, calc(100vw - 80px)"
                        fetchpriority="high"
                        loading="eager"
                    />
                    {image.caption && <figcaption class="mt-2 text-xs sm:text-sm">{image.caption}</figcaption>}
                </figure>
            )}
        </section>
    )
}
