---
import { marked } from 'marked';
import type { Hero as HeroProps } from '../types';
import Button from './Button.astro';
import CustomImage from './CustomImage.astro';

type Props = HeroProps;

const { title, image, text, actions } = Astro.props;
---

{
    (title || image?.src || text || (actions && actions.length > 0)) && (
        <section class="hero-panel mb-20 grid w-full rounded-[2rem] px-6 py-8 sm:mb-24 sm:px-10 sm:py-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-center lg:gap-14 lg:px-12 lg:py-12 xl:gap-20 xl:px-14">
            <div class="relative z-10 flex flex-col gap-6 lg:py-4">
                <p class="eyebrow">Felix · 个人空间</p>
                {
                    title && (
                        <h1 class="text-balance font-serif text-4xl leading-[1.06] font-medium tracking-[-0.035em] sm:text-5xl lg:text-6xl xl:text-7xl">
                            {title}
                        </h1>
                    )
                }
                {text && <div class="prose sm:prose-lg max-w-xl" set:html={marked.parse(text)} />}
                {
                    actions && actions.length > 0 && (
                        <div class="flex flex-wrap gap-4 pt-1">
                            {actions.map((action) => (
                                <Button href={action.href}>{action.text}</Button>
                            ))}
                        </div>
                    )
                }
            </div>

            {
                image?.src && (
                    <figure class="relative z-10 mt-10 lg:mt-0">
                        <div class="absolute -inset-3 rounded-[1.75rem] bg-accent-soft blur-2xl" aria-hidden="true" />
                        <CustomImage
                            class="border-main relative aspect-[4/3] w-full rounded-[1.5rem] border object-cover grayscale contrast-105 shadow-[0_28px_70px_-42px_var(--shadow-color)]"
                            {...image}
                            widths={[480, 640, 768, 1024, 1280, 1536]}
                            sizes="(min-width: 1280px) 560px, (min-width: 1024px) 48vw, calc(100vw - 64px)"
                            fetchpriority="high"
                            loading="eager"
                        />
                        {image.caption && <figcaption class="text-muted-foreground mt-3 text-xs sm:text-sm">{image.caption}</figcaption>}
                    </figure>
                )
            }
        </section>
    )
}
