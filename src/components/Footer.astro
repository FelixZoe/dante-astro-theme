---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks ?? [];
const navLinks = siteConfig.footerNavLinks ?? [];
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-6xl pt-16 pb-10 sm:pt-24 sm:pb-14">
    <div class="border-main border-t pt-7">
        {
            navLinks.length > 0 && (
                <nav class="mb-5 flex flex-wrap gap-x-6 gap-y-2" aria-label="页脚导航">
                    {navLinks.map((link) => (
                        <a class="text-muted-foreground text-sm font-medium transition-colors hover:text-accent" href={link.href}>
                            {link.text}
                        </a>
                    ))}
                </nav>
            )
        }
        <div
            class:list={[
                'text-muted-foreground flex flex-col gap-4 text-sm',
                { 'sm:flex-row-reverse sm:items-center sm:justify-between': socialLinks.length > 0 }
            ]}
        >
            {
                socialLinks.length > 0 && (
                    <div class="flex flex-wrap gap-x-4 gap-y-2">
                        {socialLinks.map((link) => (
                            <a
                                class="inline-flex items-center justify-center font-medium transition-colors hover:text-accent"
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {link.text}
                            </a>
                        ))}
                    </div>
                )
            }
            <p class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
                <span>
                    &copy; {currentYear}{' '}
                    <a class="font-medium text-main transition-colors hover:text-accent" href="/">{siteConfig.title}</a> 版权所有
                </span>
            </p>
        </div>
    </div>
</footer>
